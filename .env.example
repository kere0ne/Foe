FOE_DATA_DIR=./data
FOE_MAX_UPLOAD_BYTES=20971520
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDERS=
# Set to your Ollama server URL (must be reachable by the app and use a real Ollama API)
OLLAMA_BASE_URL=http://localhost:11434
# Only if the Ollama endpoint requires a Bearer token (e.g. ollama.com cloud)
# OLLAMA_API_KEY=
OLLAMA_MODEL=foe:latest
FOE_SANDBOX_IMAGE=foe-agent-sandbox:latest
FOE_ALLOW_HOST_COMMANDS=false

FOE_AUTO_MEMORY=true
FOE_MAX_MEMORIES=500
FOE_WEB_FETCH_CHARS=9000

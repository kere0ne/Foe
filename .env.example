FOE_DATA_DIR=./data
FOE_MAX_UPLOAD_BYTES=20971520
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDERS=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=foe:latest
# Optional: point the web app at a separately running, trained Foe Native API.
# Set AI_PROVIDER=foe only after a trained checkpoint is served and reachable.
FOE_NATIVE_BASE_URL=http://127.0.0.1:8090/v1
FOE_NATIVE_API_KEY=
FOE_NATIVE_MODEL=foe-native
FOE_SANDBOX_IMAGE=foe-agent-sandbox:latest
FOE_ALLOW_HOST_COMMANDS=false

FOE_AUTO_MEMORY=true
FOE_MAX_MEMORIES=500
FOE_WEB_FETCH_CHARS=9000
